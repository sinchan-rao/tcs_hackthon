<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinChat â€” AI Banking Assistant</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-container">
        <!-- Login Screen -->
        <div id="login-screen" class="screen active">
            <div class="login-wrapper">
                <div class="brand-badge">
                    <div class="brand-logo">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2L2 7h20L12 2z"/>
                        </svg>
                    </div>
                    <span>FinChat AI</span>
                </div>
                
                <h1>Conversational Banking</h1>
                <p class="subtitle">Experience generative AI banking in English & Kannada</p>
                
                <div class="login-form">
                    <div class="form-group">
                        <label for="customer-select">Select Profile</label>
                        <select id="customer-select">
                            <option value="guest">Guest Mode (General Queries & FAQs)</option>
                            <option value="CUST001" selected>Rahul Sharma (CUST001)</option>
                            <option value="CUST002">Priya Patel (CUST002)</option>
                            <option value="CUST003">Suresh Kumar (CUST003)</option>
                            <option value="CUST004">Ananya Rao (CUST004)</option>
                            <option value="CUST005">Vikram Singh (CUST005)</option>
                        </select>
                    </div>
                    
                    <div id="pin-container" class="form-group">
                        <div class="label-row">
                            <label for="pin-input">Enter Security PIN</label>
                            <span id="pin-hint" class="hint">Demo PIN: 1234</span>
                        </div>
                        <input type="password" id="pin-input" placeholder="Enter 4-digit PIN" maxlength="4">
                    </div>
                    
                    <button id="login-btn" class="primary-btn">
                        <span>Access FinChat</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>

                    <div class="hackathon-tag">
                        <span>Mock Banking Prototype &bull; Fictional Data Only</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Screen -->
        <div id="chat-screen" class="screen">
            <header class="app-header">
                <div class="header-left">
                    <div class="header-logo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2L2 7h20L12 2z"/></svg>
                    </div>
                    <div class="header-meta">
                        <h2>FinChat Assistant</h2>
                        <div class="status-indicator">
                            <span class="status-dot"></span>
                            <span id="user-greeting">Welcome, Rahul Sharma</span>
                            <span id="conversation-status" class="conversation-status" aria-live="polite"></span>
                        </div>
                    </div>
                </div>
                <div class="header-right">
                    <span id="header-balance-badge" class="balance-badge" style="display:none;">Bal: â‚¹52,430</span>
                    <button id="new-conversation-btn" class="new-conversation-btn" title="Start a new conversation">
                        <span>+ New Conversation</span>
                    </button>
                    <button id="logout-btn" class="icon-btn" title="Switch User / Logout">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                    </button>
                </div>
            </header>
            
            <div class="chat-container" id="chat-container">
                <!-- Welcome Bot Message -->
                <div class="message bot">
                    <div class="message-bubble">
                        <div class="message-sender">FinChat Assistant</div>
                        <div class="message-content">
                            Hello! I am your AI banking assistant. You can ask me about account balances, recent transactions, spending insights, loans, EMI, or transfer money with OTP verification. I speak English and Kannada (à²•à²¨à³à²¨à²¡)!
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Dynamic Suggestion Chips -->
            <div class="suggestions-wrapper">
                <div class="suggested-queries" id="suggested-queries">
                    <!-- Populated by JS -->
                </div>
            </div>
            
            <!-- Chat Input Bar -->
            <div class="input-area">
                <input type="text" id="chat-input" placeholder="Ask in English or à²•à²¨à³à²¨à²¡ (e.g. What is my balance?)..." autocomplete="off">
                <button id="send-btn" class="send-btn" title="Send Message">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                </button>
            </div>
        </div>

        <!-- Dedicated OTP Modal / Verification Overlay -->
        <div id="otp-modal" class="modal-overlay" style="display: none;">
            <div class="modal-card">
                <div class="modal-header">
                    <div class="shield-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <h3 id="modal-title">Authorize Fund Transfer</h3>
                    <p id="modal-subtitle" class="modal-subtitle">A simulated OTP has been generated for security</p>
                </div>

                <div class="modal-body">
                    <div class="transfer-summary-box">
                        <div class="transfer-row">
                            <span id="modal-row-label">Recipient:</span>
                            <strong id="modal-recipient">Rahul</strong>
                        </div>
                        <div class="transfer-row" id="modal-amount-row">
                            <span id="modal-amount-label">Transfer Amount:</span>
                            <strong id="modal-amount" class="text-primary">â‚¹2,000.00</strong>
                        </div>
                        <div class="demo-otp-badge">
                            <span>Demo OTP: <strong>123456</strong></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="otp-code-input">Enter 6-Digit OTP</label>
                        <input type="text" id="otp-code-input" maxlength="6" placeholder="123456" class="otp-input" value="123456">
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="modal-cancel-btn" class="secondary-btn">Cancel</button>
                    <button id="modal-verify-btn" class="primary-btn">
                        <span id="modal-verify-btn-text">Verify & Transfer</span>
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script src="script.js"></script>
</body>
</html>

